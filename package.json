{
  "name": "anime-exchange-bot",
  "version": "5.0.0",
  "private": true,
  "type": "module",
  "description": "Discord Anime Exchange bot on Cloudflare Workers (HTTP interactions + D1 + Google Drive/Sheets/Docs)",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "register": "node scripts/register-commands.mjs",
    "migrate": "wrangler d1 migrations apply anime-exchange --remote",
    "migrate:local": "wrangler d1 migrations apply anime-exchange --local"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260730.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0",
    "wrangler": "^4.20.0"
  }
}
